# Module metadata for frameworks that speak the modern libxposed API (Vector).
#
# minApiVersion is 100 because both alternatives were measured on the older
# framework, and only this one leaves the module alive on both devices:
#
#   101 - LSPosed 1.10.2 refuses the module outright ("this module requires a
#         newer Xposed version (101), so it cannot be activated"). It does not
#         fall back to assets/xposed_init.
#   100 - it accepts the module, finds this entry through java_init.list, and
#         then constructs it the pre-101 way, with (XposedInterface,
#         ModuleLoadedParam) as constructor arguments. Without that constructor
#         it dies with NoSuchMethodException and, again, does not fall back -
#         which leaves the module loaded nowhere.
#
# So 100 plus a constructor for the old convention is the combination that
# works. Vector (API 102) ignores the old constructor and uses the modern
# no-argument one; LSPosed (API 100) uses the old one. See VectorModule.
minApiVersion=100
targetApiVersion=102

# Whether the scope below is a fixed contract rather than a suggestion. Left
# false on purpose: which applications this module is injected into is the
# user's decision, made in the manager, and it differs per device.
staticScope=false
